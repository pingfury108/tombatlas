---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TombPlan from '../../components/TombPlan.astro';
import TombScene from '../../components/TombScene.astro';

export async function getStaticPaths() {
  const tombs = await getCollection('tombs', ({ data }) => !data.draft);
  return tombs.map((tomb) => ({ params: { slug: tomb.id }, props: { tomb } }));
}

const { tomb } = Astro.props;
const { Content } = await render(tomb);
const scene = await getEntry('scenes', tomb.id);

const artifactEntries = await getCollection('artifacts');
const sceneConfig = scene && {
  chambers: scene.data.chambers,
  corridors: scene.data.corridors,
  furnishings: scene.data.furnishings,
  artifacts: scene.data.artifacts.map((a) => {
    const meta = artifactEntries.find((x) => x.id === a.id);
    return { ...a, name: meta?.data.name ?? a.id, desc: meta?.data.description ?? '', url: `/artifacts/${a.id}/` };
  }),
};

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  name: tomb.data.title,
  description: tomb.data.description,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
};
---

<BaseLayout title={tomb.data.title} description={tomb.data.description} ogType="article" jsonld={jsonld}>
  <p class="meta"><a href="/">← 返回目录</a></p>
  <h1>{tomb.data.title}</h1>
  <p class="meta">
    {tomb.data.dynasty} · {tomb.data.region}
    {tomb.data.tombOwner && ` · ${tomb.data.tombOwner}`}
  </p>
  <p>
    {tomb.data.tags.map((t) => <span class="tag">{t}</span>)}
  </p>

  {sceneConfig && (
    <>
      <h2>3D 漫游</h2>
      <TombScene config={sceneConfig} />
    </>
  )}

  {scene && (
    <>
      <h2>结构示意图</h2>
      <TombPlan scene={scene.data} artifactNames={Object.fromEntries(artifactEntries.map((a) => [a.id, a.data.name]))} />
    </>
  )}

  <article>
    <Content />
  </article>
</BaseLayout>
